{
  "name": "nexora",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @nexora/database db:generate",
    "db:migrate": "pnpm --filter @nexora/database db:migrate"
  },
  "devDependencies": {
    "turbo": "2.5.6",
    "typescript": "5.9.3",
    "@types/node": "22.19.1"
  }
}
