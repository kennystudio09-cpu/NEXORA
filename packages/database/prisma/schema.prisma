generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  OWNER
  MANAGER
  STAFF
}
model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  platformAdmin Boolean @default(false)
  createdAt DateTime @default(now())
  memberships Membership[]
  sessions Session[]
  customerFollowUps CustomerFollowUp[]
  createdOrders Order[] @relation("OrderCreator")
  customerOrders Order[] @relation("OrderCustomer")
  orderHistory OrderStatusHistory[]
  orderEvents OrderEvent[]
  idempotencyKeys IdempotencyKey[]
  supportConversations Conversation[]
  supportParticipants ConversationParticipant[]
  customerAccountLinks CustomerAccountLink[]
}
model Tenant {
  id String @id @default(uuid())
  name String
  createdAt DateTime @default(now())
  memberships Membership[]
  sessions Session[]
  customers Customer[]
  catalogSlug String? @unique @map("catalog_slug")
  catalogPublic Boolean @default(false) @map("catalog_public")
  catalogItems CatalogItem[]
  catalogCategories CatalogCategory[]
  priceLists PriceList[]
  orders Order[]
  storefrontKey String @unique @default(dbgenerated("(gen_random_uuid())::text")) @map("storefront_key")
  storefrontProfile StorefrontProfile?
  aiAgent AIAgent?
  aiSettings AISettings?
  knowledgeBases KnowledgeBase[]
  supportChannels SupportChannel[]
  supportConversations Conversation[]
  customerAccountLinks CustomerAccountLink[]
}
model Membership {
  supportAssignments ConversationAssignment[]
  userId String
  tenantId String
  role Role
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@id([userId, tenantId])
  @@index([tenantId])
}
model Session {
  id String @id
  userId String
  activeTenantId String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant Tenant? @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([expiresAt])
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

model Customer {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  name String @db.VarChar(120)
  email String? @db.VarChar(254)
  phone String? @db.VarChar(40)
  status CustomerStatus @default(LEAD)
  tags String[] @default([])
  notes String @default("") @db.VarChar(4000)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  followUps CustomerFollowUp[]
  orders Order[]
  supportConversations Conversation[]
  accountLink CustomerAccountLink?
  @@unique([tenantId, id])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, status])
  @@index([tags], type: Gin)
}

model CustomerFollowUp {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  customerId String @map("customer_id")
  authorId String @map("author_id")
  content String @db.VarChar(2000)
  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt DateTime @default(now()) @map("created_at")
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([tenantId, customerId, createdAt, id])
}

enum CatalogItemType {
  PRODUCT
  SERVICE
  DIGITAL
  BUNDLE
}
enum CatalogStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
model CatalogCategory {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  name String @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items CatalogItem[]
  @@unique([tenantId, id])
  @@unique([tenantId, name])
}
model CatalogItem {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  name String @db.VarChar(160)
  description String @default("") @db.VarChar(6000)
  itemType CatalogItemType @default(PRODUCT)
  sku String? @db.VarChar(64)
  currencyCode String @default("MYR") @db.VarChar(3)
  basePrice Decimal @db.Decimal(18,4)
  status CatalogStatus @default(DRAFT)
  categoryId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category CatalogCategory? @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  variants CatalogVariant[]
  media CatalogMedia[]
  orderItems OrderItem[]
  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@index([tenantId, status, createdAt, id])
}
model CatalogVariant {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  itemId String @map("item_id")
  name String @db.VarChar(100)
  sku String? @db.VarChar(64)
  price Decimal @db.Decimal(18,4)
  active Boolean @default(true)
  item CatalogItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  @@unique([tenantId, id])
  orderItems OrderItem[]
  @@unique([tenantId, itemId, id])
  @@unique([tenantId, itemId, name])
  @@unique([tenantId, sku])
}
model CatalogMedia {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  itemId String @map("item_id")
  mimeType String @default("image/webp")
  content Bytes
  size Int
  width Int
  height Int
  altText String @default("") @db.VarChar(160)
  createdAt DateTime @default(now())
  item CatalogItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  @@unique([tenantId, id])
  @@index([tenantId, itemId])
}
model PriceList {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  name String @db.VarChar(100)
  currencyCode String @default("MYR") @db.VarChar(3)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}
enum OrderSource {
  MERCHANT
  CUSTOMER
  AI
  APPOINTMENT
}
model Order {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  orderNumber String @db.VarChar(40)
  contactId String?
  contactNameSnapshot String? @db.VarChar(120)
  customerUserId String?
  createdById String
  source OrderSource @default(MERCHANT)
  status OrderStatus @default(DRAFT)
  currencyCode String @db.VarChar(3)
  subtotal Decimal @db.Decimal(24,4)
  discountTotal Decimal @default(0) @db.Decimal(24,4)
  taxTotal Decimal @default(0) @db.Decimal(24,4)
  grandTotal Decimal @db.Decimal(24,4)
  notes String @default("") @db.VarChar(4000)
  customerNote String @default("") @db.VarChar(1000)
  sourceChannel String? @db.VarChar(32)
  paymentStatus PaymentStatus @default(UNPAID)
  storeNameSnapshot String? @db.VarChar(160)
  storeSlugSnapshot String? @db.VarChar(60)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contact Customer? @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  customerUser User? @relation("OrderCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)
  createdBy User @relation("OrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items OrderItem[]
  history OrderStatusHistory[]
  events OrderEvent[]
  idempotencyKeys IdempotencyKey[]
  @@unique([tenantId, id])
  @@unique([tenantId, orderNumber])
  @@index([tenantId, status, createdAt, id])
  @@index([customerUserId, source, createdAt, id])
  @@index([tenantId, contactId])
}
model OrderItem {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  orderId String @map("order_id")
  position Int
  catalogItemId String
  catalogVariantId String?
  itemNameSnapshot String @db.VarChar(160)
  variantNameSnapshot String? @db.VarChar(100)
  skuSnapshot String? @db.VarChar(64)
  unitPriceSnapshot Decimal @db.Decimal(18,4)
  quantity Int
  lineTotal Decimal @db.Decimal(24,4)
  order Order @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  catalogItem CatalogItem @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Restrict)
  catalogVariant CatalogVariant? @relation(fields: [tenantId, catalogItemId, catalogVariantId], references: [tenantId, itemId, id], onDelete: Restrict)
  @@unique([tenantId, orderId, position])
}
model OrderStatusHistory {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  orderId String @map("order_id")
  actorId String
  fromStatus OrderStatus?
  toStatus OrderStatus
  version Int
  reason String @default("") @db.VarChar(1000)
  createdAt DateTime @default(now())
  order Order @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([tenantId, orderId, version])
}
model OrderEvent {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  orderId String @map("order_id")
  actorId String
  type String @db.VarChar(32)
  version Int
  payload Json
  createdAt DateTime @default(now())
  order Order @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([tenantId, orderId, version])
}
model IdempotencyKey {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  actorId String
  key String @db.VarChar(128)
  operation String @default("MERCHANT_ORDER_CREATE") @db.VarChar(40)
  requestHash String @db.VarChar(64)
  orderId String @map("order_id")
  response Json
  createdAt DateTime @default(now())
  order Order @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([tenantId, actorId, key])
  @@index([tenantId, orderId])
}

enum PaymentStatus {
  UNPAID
}
model StorefrontProfile {
  tenantId String @id @map("tenant_id")
  displayName String @default("") @db.VarChar(160)
  description String @default("") @db.VarChar(2000)
  address String @default("") @db.VarChar(500)
  businessHours String @default("") @db.VarChar(1000)
  phone String @default("") @db.VarChar(40)
  email String @default("") @db.VarChar(254)
  logoData Bytes?
  logoMime String?
  logoWidth Int?
  logoHeight Int?
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}
model CustomerAccountLink {
  tenantId String @map("tenant_id")
  userId String @map("user_id")
  contactId String @map("contact_id")
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  contact Customer @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  @@id([tenantId, userId])
  @@unique([tenantId, contactId])
}

enum SupportSenderType {
  CUSTOMER
  STAFF
  AI
}
enum ConversationStatus {
  OPEN
  CLOSED
}
enum SupportDeliveryStatus {
  PERSISTED
  DELIVERED
  READ
}
model SupportChannel {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  kind String @default("WEB") @db.VarChar(32)
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
  conversations Conversation[]
  @@unique([tenantId,id])
  @@unique([tenantId,kind])
}
model Conversation {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  channelId String
  customerUserId String
  contactId String
  aiHumanRequired Boolean @default(false)
  aiState String @default("HUMAN") @db.VarChar(32)
  aiGeneration Int @default(0)
  aiUsage AIUsageRecord[]
  status ConversationStatus @default(OPEN)
  lastSequence Int @default(0)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
  channel SupportChannel @relation(fields:[tenantId,channelId],references:[tenantId,id],onDelete:Restrict)
  customerUser User @relation(fields:[customerUserId],references:[id],onDelete:Restrict)
  contact Customer @relation(fields:[tenantId,contactId],references:[tenantId,id],onDelete:Restrict)
  participants ConversationParticipant[]
  messages Message[]
  assignments ConversationAssignment[]
  events ConversationEvent[]
  @@unique([tenantId,id])
  @@unique([tenantId,channelId,customerUserId])
  @@index([tenantId,status,updatedAt])
  @@index([customerUserId,updatedAt])
}
model ConversationParticipant {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  conversationId String
  userId String?
  senderType SupportSenderType
  active Boolean @default(true)
  lastReadSequence Int @default(0)
  joinedAt DateTime @default(now())
  conversation Conversation @relation(fields:[tenantId,conversationId],references:[tenantId,id],onDelete:Restrict)
  user User? @relation(fields:[userId],references:[id],onDelete:Restrict)
  messages Message[]
  deliveries MessageDelivery[]
  @@unique([tenantId,conversationId,id])
  @@unique([tenantId,conversationId,userId,senderType])
}
model Message {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  conversationId String
  senderParticipantId String
  senderType SupportSenderType
  channel String @default("WEB") @db.VarChar(32)
  sequence Int
  content String @db.VarChar(4000)
  status String @default("SENT") @db.VarChar(16)
  clientKey String @db.VarChar(128)
  requestHash String @db.VarChar(64)
  sentAt DateTime @default(now())
  conversation Conversation @relation(fields:[tenantId,conversationId],references:[tenantId,id],onDelete:Restrict)
  sender ConversationParticipant @relation(fields:[tenantId,conversationId,senderParticipantId],references:[tenantId,conversationId,id],onDelete:Restrict)
  deliveries MessageDelivery[]
  aiTriggers AIUsageRecord[]
  citations Json @default("[]")
  @@unique([tenantId,conversationId,id])
  @@unique([tenantId,conversationId,sequence])
  @@unique([tenantId,conversationId,senderParticipantId,clientKey])
}
model ConversationAssignment {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  conversationId String
  assigneeId String
  assignedById String
  assignedAt DateTime @default(now())
  endedAt DateTime?
  conversation Conversation @relation(fields:[tenantId,conversationId],references:[tenantId,id],onDelete:Restrict)
  assignee Membership @relation(fields:[assigneeId,tenantId],references:[userId,tenantId],onDelete:Restrict)
  @@index([tenantId,conversationId,endedAt])
}
model ConversationEvent {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  conversationId String
  actorId String
  type String @db.VarChar(32)
  version Int
  payload Json
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields:[tenantId,conversationId],references:[tenantId,id],onDelete:Restrict)
  @@unique([tenantId,conversationId,version])
}
model MessageDelivery {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  conversationId String
  messageId String
  participantId String
  status SupportDeliveryStatus @default(PERSISTED)
  deliveredAt DateTime?
  readAt DateTime?
  message Message @relation(fields:[tenantId,conversationId,messageId],references:[tenantId,conversationId,id],onDelete:Restrict)
  participant ConversationParticipant @relation(fields:[tenantId,conversationId,participantId],references:[tenantId,conversationId,id],onDelete:Restrict)
  @@unique([tenantId,messageId,participantId])
  @@index([tenantId,conversationId,participantId,status])
}

model AIAgent {
 id String @id @default(uuid())
 tenantId String @unique @map("tenant_id")
 name String @default("NEXORA Assistant") @db.VarChar(80)
 welcome String @default("") @db.VarChar(300)
 tone String @default("PROFESSIONAL") @db.VarChar(20)
 language String @default("en") @db.VarChar(2)
 revision Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
 versions AIAgentVersion[]
 settings AISettings?
 usages AIUsageRecord[]
 @@unique([tenantId,id])
}
model AIAgentVersion {
 id String @id @default(uuid())
 tenantId String @map("tenant_id")
 agentId String
 revision Int
 actorId String
 action String @db.VarChar(32)
 snapshot Json
 createdAt DateTime @default(now())
 agent AIAgent @relation(fields:[tenantId,agentId],references:[tenantId,id],onDelete:Restrict)
 @@unique([tenantId,agentId,revision])
}
model AISettings {
 @@unique([tenantId,agentId])
 tenantId String @id @map("tenant_id")
 agentId String @unique
 enabled Boolean @default(false)
 autoReply Boolean @default(false)
 mode String @default("HUMAN_FIRST") @db.VarChar(20)
 tokenQuota Int @default(100000)
 requestsPerMinute Int @default(10)
 period String @default("") @db.VarChar(7)
 usedTokens Int @default(0)
 reservedTokens Int @default(0)
 updatedAt DateTime @updatedAt
 tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
 agent AIAgent @relation(fields:[tenantId,agentId],references:[tenantId,id],onDelete:Restrict)
}
model AIUsageRecord {
 id String @id @default(uuid())
 tenantId String @map("tenant_id")
 agentId String
 agentRevision Int
 conversationId String?
 triggerMessageId String?
 actorId String
 requestKey String @db.VarChar(128)
 kind String @db.VarChar(16)
 status String @default("PENDING") @db.VarChar(20)
 reason String @default("") @db.VarChar(40)
 provider String @default("openai") @db.VarChar(32)
 model String @db.VarChar(80)
 promptHash String @db.VarChar(64)
 language String @db.VarChar(2)
 inputTokens Int @default(0)
 outputTokens Int @default(0)
 reservedTokens Int @default(0)
 estimatedCostUsd Decimal? @db.Decimal(18,8)
 usageKnown Boolean @default(false)
 latencyMs Int @default(0)
 attempts Int @default(0)
 evidence Json @default("[]")
 createdAt DateTime @default(now())
 startedAt DateTime?
 completedAt DateTime?
 agent AIAgent @relation(fields:[tenantId,agentId],references:[tenantId,id],onDelete:Restrict)
 conversation Conversation? @relation(fields:[tenantId,conversationId],references:[tenantId,id],onDelete:Restrict)
 trigger Message? @relation(fields:[tenantId,conversationId,triggerMessageId],references:[tenantId,conversationId,id],onDelete:Restrict)
 @@unique([tenantId,id])
 @@unique([tenantId,triggerMessageId])
 @@unique([tenantId,actorId,requestKey])
 @@index([status,createdAt])
}
model KnowledgeBase {
 id String @id @default(uuid())
 tenantId String @map("tenant_id")
 name String @default("Support") @db.VarChar(80)
 createdAt DateTime @default(now())
 tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
 documents KnowledgeDocument[]
 @@unique([tenantId,id])
 @@unique([tenantId,name])
}
model KnowledgeDocument {
 id String @id @default(uuid())
 tenantId String @map("tenant_id")
 baseId String
 title String @db.VarChar(120)
 questions Json
 answers Json
 status String @default("ACTIVE") @db.VarChar(16)
 revision Int @default(1)
 actorId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 base KnowledgeBase @relation(fields:[tenantId,baseId],references:[tenantId,id],onDelete:Restrict)
 chunks KnowledgeChunk[]
 @@unique([tenantId,id])
 @@index([tenantId,status])
}
model KnowledgeChunk {
 id String @id @default(uuid())
 tenantId String @map("tenant_id")
 documentId String
 revision Int
 language String @db.VarChar(2)
 searchText String @db.VarChar(2000)
 answer String @db.VarChar(2000)
 active Boolean @default(true)
 createdAt DateTime @default(now())
 document KnowledgeDocument @relation(fields:[tenantId,documentId],references:[tenantId,id],onDelete:Restrict)
 @@unique([tenantId,documentId,revision,language])
 @@index([tenantId,active,language])
}
