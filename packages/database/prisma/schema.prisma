generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  OWNER
  MANAGER
  STAFF
}
model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  platformAdmin Boolean @default(false)
  createdAt DateTime @default(now())
  memberships Membership[]
  sessions Session[]
  customerFollowUps CustomerFollowUp[]
  createdOrders Order[] @relation("OrderCreator")
  customerOrders Order[] @relation("OrderCustomer")
  orderHistory OrderStatusHistory[]
  orderEvents OrderEvent[]
  idempotencyKeys IdempotencyKey[]
}
model Tenant {
  id String @id @default(uuid())
  name String
  createdAt DateTime @default(now())
  memberships Membership[]
  sessions Session[]
  customers Customer[]
  catalogSlug String? @unique @map("catalog_slug")
  catalogPublic Boolean @default(false) @map("catalog_public")
  catalogItems CatalogItem[]
  catalogCategories CatalogCategory[]
  priceLists PriceList[]
  orders Order[]
}
model Membership {
  userId String
  tenantId String
  role Role
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@id([userId, tenantId])
  @@index([tenantId])
}
model Session {
  id String @id
  userId String
  activeTenantId String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant Tenant? @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([expiresAt])
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

model Customer {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  name String @db.VarChar(120)
  email String? @db.VarChar(254)
  phone String? @db.VarChar(40)
  status CustomerStatus @default(LEAD)
  tags String[] @default([])
  notes String @default("") @db.VarChar(4000)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  followUps CustomerFollowUp[]
  orders Order[]
  @@unique([tenantId, id])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, status])
  @@index([tags], type: Gin)
}

model CustomerFollowUp {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  customerId String @map("customer_id")
  authorId String @map("author_id")
  content String @db.VarChar(2000)
  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt DateTime @default(now()) @map("created_at")
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([tenantId, customerId, createdAt, id])
}

enum CatalogItemType {
  PRODUCT
  SERVICE
  DIGITAL
  BUNDLE
}
enum CatalogStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
model CatalogCategory {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  name String @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items CatalogItem[]
  @@unique([tenantId, id])
  @@unique([tenantId, name])
}
model CatalogItem {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  name String @db.VarChar(160)
  description String @default("") @db.VarChar(6000)
  itemType CatalogItemType @default(PRODUCT)
  sku String? @db.VarChar(64)
  currencyCode String @default("MYR") @db.VarChar(3)
  basePrice Decimal @db.Decimal(18,4)
  status CatalogStatus @default(DRAFT)
  categoryId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category CatalogCategory? @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  variants CatalogVariant[]
  media CatalogMedia[]
  orderItems OrderItem[]
  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@index([tenantId, status, createdAt, id])
}
model CatalogVariant {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  itemId String @map("item_id")
  name String @db.VarChar(100)
  sku String? @db.VarChar(64)
  price Decimal @db.Decimal(18,4)
  active Boolean @default(true)
  item CatalogItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  @@unique([tenantId, id])
  orderItems OrderItem[]
  @@unique([tenantId, itemId, id])
  @@unique([tenantId, itemId, name])
  @@unique([tenantId, sku])
}
model CatalogMedia {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  itemId String @map("item_id")
  mimeType String @default("image/webp")
  content Bytes
  size Int
  width Int
  height Int
  altText String @default("") @db.VarChar(160)
  createdAt DateTime @default(now())
  item CatalogItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  @@unique([tenantId, id])
  @@index([tenantId, itemId])
}
model PriceList {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  name String @db.VarChar(100)
  currencyCode String @default("MYR") @db.VarChar(3)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}
enum OrderSource {
  MERCHANT
  CUSTOMER
  AI
  APPOINTMENT
}
model Order {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  orderNumber String @db.VarChar(40)
  contactId String?
  contactNameSnapshot String? @db.VarChar(120)
  customerUserId String?
  createdById String
  source OrderSource @default(MERCHANT)
  status OrderStatus @default(DRAFT)
  currencyCode String @db.VarChar(3)
  subtotal Decimal @db.Decimal(24,4)
  discountTotal Decimal @default(0) @db.Decimal(24,4)
  taxTotal Decimal @default(0) @db.Decimal(24,4)
  grandTotal Decimal @db.Decimal(24,4)
  notes String @default("") @db.VarChar(4000)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contact Customer? @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  customerUser User? @relation("OrderCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)
  createdBy User @relation("OrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items OrderItem[]
  history OrderStatusHistory[]
  events OrderEvent[]
  idempotencyKeys IdempotencyKey[]
  @@unique([tenantId, id])
  @@unique([tenantId, orderNumber])
  @@index([tenantId, status, createdAt, id])
  @@index([customerUserId, source, createdAt, id])
  @@index([tenantId, contactId])
}
model OrderItem {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  orderId String @map("order_id")
  position Int
  catalogItemId String
  catalogVariantId String?
  itemNameSnapshot String @db.VarChar(160)
  variantNameSnapshot String? @db.VarChar(100)
  skuSnapshot String? @db.VarChar(64)
  unitPriceSnapshot Decimal @db.Decimal(18,4)
  quantity Int
  lineTotal Decimal @db.Decimal(24,4)
  order Order @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  catalogItem CatalogItem @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Restrict)
  catalogVariant CatalogVariant? @relation(fields: [tenantId, catalogItemId, catalogVariantId], references: [tenantId, itemId, id], onDelete: Restrict)
  @@unique([tenantId, orderId, position])
}
model OrderStatusHistory {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  orderId String @map("order_id")
  actorId String
  fromStatus OrderStatus?
  toStatus OrderStatus
  version Int
  reason String @default("") @db.VarChar(1000)
  createdAt DateTime @default(now())
  order Order @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([tenantId, orderId, version])
}
model OrderEvent {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  orderId String @map("order_id")
  actorId String
  type String @db.VarChar(32)
  version Int
  payload Json
  createdAt DateTime @default(now())
  order Order @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([tenantId, orderId, version])
}
model IdempotencyKey {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  actorId String
  key String @db.VarChar(128)
  requestHash String @db.VarChar(64)
  orderId String @map("order_id")
  response Json
  createdAt DateTime @default(now())
  order Order @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([tenantId, actorId, key])
  @@index([tenantId, orderId])
}
