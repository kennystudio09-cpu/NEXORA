# Local development only. Replace placeholder password before starting services.
POSTGRES_USER=nexora
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=nexora
DATABASE_URL=postgresql://nexora:replace-with-local-password@localhost:5432/nexora
REDIS_URL=redis://localhost:6379
API_PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
COOKIE_SECURE=false
API_INTERNAL_URL=http://localhost:4000

# Optional metadata-only Redis Pub/Sub for multiple API instances.
SUPPORT_REDIS_ADAPTER=false
