{
  "name": "@nexora/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.9",
    "@nestjs/core": "11.1.9",
    "@nestjs/platform-express": "11.1.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@nexora/database": "workspace:*",
    "@nexora/auth": "workspace:*",
    "ioredis": "5.9.2",
    "dotenv": "17.2.3"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "@types/express": "5.0.5"
  }
}
